#!/bin/sh
set -e

# Load the AppArmor profile that lets WebKit's sandbox create its user namespace.
# Without it, mdviewer aborts on Ubuntu 23.10+ the moment it shows a document.
if [ "$1" = "configure" ] && command -v apparmor_parser >/dev/null 2>&1 \
    && [ -d /sys/kernel/security/apparmor ]; then
    apparmor_parser -r -W /etc/apparmor.d/mdviewer \
        || echo "mdviewer: couldn't load /etc/apparmor.d/mdviewer; documents may fail to open" >&2
fi

#DEBHELPER#
